{
  "specialty": "ortho",
  "features": [
    {
      "feature_id": "O_T1_BCT",
      "specialty": "ortho",
      "tier": 1,
      "shortlist_eligible": true,
      "short_name": "Bilateral CTS or recurrent/revision CTS",
      "notes": "Source rule: 'G56.03 or bilateral/recurrent CTR = Tier 1.' Bilateral diagnosis alone reaches Tier 1 with no extra condition required — and recurrence/revision reaches Tier 1 on its own too, regardless of laterality (the row's rationale is that repeat CTR itself, ~26% amyloid-positive on biopsy, is the red flag, not specifically that it's bilateral). Replaces the old O_T2_BCT (was wrongly Tier 2) and O_T1_RECURRENT_BCT (was wrongly requiring bilateral+recurrent together) — see ortho row 1 clinical review.",
      "logic": {
        "op": "any",
        "atoms": [
          "cts_bilateral",
          "cts_recurrent"
        ]
      }
    },
    {
      "feature_id": "O_T1_REDFLAG_FHX_HF",
      "specialty": "ortho",
      "tier": 1,
      "shortlist_eligible": true,
      "short_name": "Ortho red flag + FHx SCD + HF",
      "logic": {
        "op": "all",
        "children": [
          {
            "op": "any",
            "children": [
              {
                "op": "any",
                "atoms": [
                  "cts_bilateral",
                  "biceps_rupture"
                ]
              },
              {
                "op": "all",
                "atoms": [
                  "cts_any",
                  "ctr_any"
                ]
              }
            ]
          },
          {
            "op": "any",
            "atoms": [
              "fhx_sudden_death"
            ]
          },
          {
            "op": "any",
            "atoms": [
              "hf_any"
            ]
          }
        ]
      }
    },
    {
      "feature_id": "O_T1_GE2_REGIONS",
      "specialty": "ortho",
      "tier": 1,
      "shortlist_eligible": true,
      "short_name": ">=2 anatomical MSK regions",
      "logic": {
        "op": "count_buckets_gate",
        "bucket_set": "msk_regions",
        "threshold": 2
      }
    },
    {
