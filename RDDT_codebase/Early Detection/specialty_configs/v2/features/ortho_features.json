    },
    {
      "feature_id": "O_T2_CTS_UNILATERAL",
      "specialty": "ortho",
      "tier": 2,
      "shortlist_eligible": true,
      "short_name": "Unilateral CTS (no bilateral, no recurrence)",
      "notes": "Source rule: 'Unilateral G56.01/G56.02 alone = Tier 2 unless clustering.' This is the case the row actually assigns to Tier 2 — previously unrepresented in this file entirely. The 'unless clustering' escalation is handled separately by O_T1_GE2_REGIONS / O_T1_GE3_MANIFEST, not duplicated here.",
      "logic": {
        "op": "all",
        "children": [
          {
            "op": "any",
            "atoms": [
              "cts_any"
            ]
          },
          {
            "op": "not",
            "atoms": [
              "cts_bilateral",
              "cts_recurrent"
            ]
          }
        ]
      }
    },
