      "namespace": "UHTX_RDDT_CLINICAL_DEV.PUBLIC",
      "description": "Decisions use CLAIMS ICD-10 codes only. ENCOUNTERS supply a date when patient plus encounter resolves to one visit date. CENSUS, ENCOUNTERS, LABS, and SURGICAL_HISTORY hydrate the patient profile and do not create evidence.",
      "tables": {
        "census": {
          "key": "census",
          "name": "CENSUS",
          "enabled": false,
          "required": false,
          "profile_enabled": true,
