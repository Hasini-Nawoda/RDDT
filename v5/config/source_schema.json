          "profile_required": true,
          "columns": {
            "patient_id": "PATIENTID",
            "encounter_id": "ENCOUNTERID",
            "claim_no": "CLAIMNO",
            "claim_line_no": "CLAIMLINENO",
            "claim_status": "CLAIMSTATUS",
            "diagnosis_type": "DIAGNOSISTYPE",
            "diagnosis_code": "DIAGNOSISCODE"
          },
          "required_columns": ["patient_id", "diagnosis_type", "diagnosis_code"],
          "mapping_notes": "Algorithmic decisions use DIAGNOSISCODE when DIAGNOSISTYPE is ICD-10-CM. Claim rows have no native date."
