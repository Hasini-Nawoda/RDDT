          "columns": {
            "patient_id": "PATIENTID",
            "birth_date": "BIRTHDATE",
            "gender": "GENDER",
            "ethnicity": "OMBETHNICITY",
            "race": "OMBRACE",
            "death_date": "DEATHDATE"
