            "encounter_id": "VISITID",
            "patient_id": "PATIENTID",
            "encounter_date": "VISITDATE",
            "encounter_type": "TYPE",
            "encounter_status": "STATUS"
          },
          "required_columns": ["encounter_id", "patient_id", "encounter_date"],
          "mapping_notes": "Visit rows date claims. They are not diagnosis evidence. A claim inherits VISITDATE only when patient plus encounter resolves to one date."
        },
